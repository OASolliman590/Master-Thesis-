{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OASolliman590/Master-Thesis-/main/specs/A_DATA_ACQUISITION_VALIDATION/schemas/cohort_admission_receipt.schema.json",
  "title": "Cohort admission receipt",
  "description": "Patient-free aggregate receipt for one study and analysis branch.",
  "type": "object",
  "required": [
    "admission_receipt_id",
    "study_id",
    "branch_id",
    "admission_version",
    "source_object_ids",
    "gate_results",
    "admission_status",
    "validator",
    "reviewer",
    "code_version",
    "config_hash",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "admission_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "publication_family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "branch_id": {
      "type": "string"
    },
    "admission_version": {
      "type": "string"
    },
    "source_object_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "source_object_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "retrieval_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_patients": {
      "type": "integer",
      "minimum": 0
    },
    "verified_specimens": {
      "type": "integer",
      "minimum": 0
    },
    "verified_assays": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_patients": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "longitudinal_patients": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "response_counts": {
      "type": "object"
    },
    "endpoint_definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "assay_platform_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "specimen_selection_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "treatment_timing_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_coverage": {
      "type": [
        "string",
        "null"
      ]
    },
    "overlap_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "prior_exposure_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_branches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_branches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusion_counts_reasons": {
      "type": "object"
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "pattern": "^V[0-9]$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED_UNKNOWN",
              "NOT_APPLICABLE",
              "SUPERSEDED"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "admission_status": {
      "type": "string",
      "enum": [
        "ADMITTED",
        "ADMITTED_WITH_LIMITATIONS",
        "SENSITIVITY_ONLY",
        "BLOCKED_UNKNOWN",
        "EXCLUDED",
        "SUPERSEDED"
      ]
    },
    "validator": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unresolved_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_utc": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
