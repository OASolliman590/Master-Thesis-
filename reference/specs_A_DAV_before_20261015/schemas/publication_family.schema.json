{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OASolliman590/Master-Thesis-/main/specs/A_DATA_ACQUISITION_VALIDATION/schemas/publication_family.schema.json",
  "title": "Publication family record",
  "description": "One record per publication within a family, preserving reused subsets and independence status.",
  "type": "object",
  "required": [
    "publication_family_id",
    "study_id",
    "publication_id",
    "publication_role",
    "independence_status",
    "source_locators"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "publication_family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "pmid": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_role": {
      "type": "string",
      "enum": [
        "PRIMARY_CLINICAL",
        "MOLECULAR",
        "FOLLOWUP",
        "SURVIVAL",
        "CORRECTION",
        "REANALYSIS",
        "ATLAS_REUSE",
        "OTHER"
      ]
    },
    "data_reused": {
      "type": [
        "string",
        "null"
      ]
    },
    "patient_subset": {
      "type": [
        "string",
        "null"
      ]
    },
    "assay_subset": {
      "type": [
        "string",
        "null"
      ]
    },
    "treatment_subset": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome_subset": {
      "type": [
        "string",
        "null"
      ]
    },
    "known_overlap": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "independence_status": {
      "type": "string",
      "enum": [
        "NOT_INDEPENDENT",
        "INDEPENDENT_RECRUITMENT",
        "UNRESOLVED",
        "NOT_APPLICABLE"
      ]
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "page_or_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_utc": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
