"id": 20237763, "name": "secondary-screen-replicate-collapsed-treatment-info.csv", "size": 3788355, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/20237763", "supplied_md5": "54765b3639f91cede751378d694e3583", "computed_md5": "54765b3639f91cede751378d694e3583", "mimetype": "text/plain"}, {"id": 20237766, "name": "secondary-screen-pooling-info.csv", "size": 264680, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/20237766", "supplied_md5": "74d2e9b1d9c8a574f2a9db3bc206f397", "computed_md5": "74d2e9b1d9c8a574f2a9db3bc206f397", "mimetype": "text/plain"}, {"id": 20237769, "name": "secondary-screen-cell-line-info.csv", "size": 40979, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/20237769", "supplied_md5": "6737b4aa9fd85404fd2f0cf825b037e4", "computed_md5": "6737b4aa9fd85404fd2f0cf825b037e4", "mimetype": "text/plain"}, {"id": 20238123, "name": "secondary-screen-readme.txt", "size": 7647, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/20238123", "supplied_md5": "421d0bbadec381adc0d7981ee7e16bd7", "computed_md5": "421d0bbadec381adc0d7981ee7e16bd7", "mimetype": "text/plain"}], "folder_structure": {}, "authors": [{"id": 5514062, "full_name": "Broad DepMap", "first_name": "Broad", "last_name": "DepMap", "is_active": true, "url_name": "Broad_DepMap", "orcid_id": ""}, {"id": 7165175, "full_name": "Steven Corsello", "first_name": "Steven", "last_name": "Corsello", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9929-3709"}, {"id": 7165454, "full_name": "Mustafa Kocak", "first_name": "Mustafa", "last_name": "Kocak", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5971-5439"}, {"id": 7165464, "full_name": "Todd Golub", "first_name": "Todd", "last_name": "Golub", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0113-2403"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/PRISM_Repurposing_19Q3_Primary_Screen/9393293", "download_disabled": false, "description": "<h2>The PRISM Repurposing release contains small molecule viability datasets generated using the Broad Repurposing Library and the PRISM multiplexed cell-line viability assay.</h2><h2><br></h2><h2>The primary PRISM Repurposing dataset contains the results of pooled-cell line chemical-perturbation viability screens for 4,518 compounds screened against 578 or 562 cell lines. </h2><h2><br></h2><h2>The secondary PRISM Repurposing dataset contains the results of pooled-cell line chemical-perturbation viability screens for 1,448 compounds screened against 489 cell lines in an 8-step, 4-fold dilution, starting from 10uM. Technical redos for 147 previously screened oncology compounds have been added as of 11/22/2019. This data is identified using a `screen_id` of \"MTS010\".  It is recommended to use MTS010 when available. MTS010 was not included in the analysis for Corsello et al. 2019, DOI:10.1101/730119.</h2><h2><br></h2><h2>Data processing steps are described in the README files. Further descriptions of methods are available at https://doi.org/10.1101/730119.</h2><div><br></div>", "funding": null, "funding_list": [], "version": 4, "status": "public", "size": 1010555140, "created_date": "2019-12-17T21:34:58Z", "modified_date": "2019-12-17T21:35:08Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["PRISM", "Cancer genomics", "Drug screening", "Biomarker discovery", "Drug repurposing", "Cancer Cell Biology", "Cancer Therapy (excl. Chemotherapy and Radiation Therapy)", "Cancer", "Pharmacogenomics"], "keywords": ["PRISM", "Cancer genomics", "Drug screening", "Biomarker discovery", "Drug repurposing", "Cancer Cell Biology", "Cancer Therapy (excl. Chemotherapy and Radiation Therapy)", "Cancer", "Pharmacogenomics"], "categories