+def _safe_destination(destination: Path) -> Path:
+    target=Path(destination)
+    require('..' not in target.parts,'UNSAFE_DESTINATION')
+    require(not any(path.is_symlink() for path in (target,*target.parents)),'UNSAFE_DESTINATION')
