+def _blocked_tie(stage: str, packet: dict[str,Any], records: dict[str,Any], audit: list[dict[str,Any]],
+                 error: DavError, store: SchemaStore) -> dict[str,Any]:
+    if error.code!='SELECTION_TIE':raise error
