+    if 'timing' in stages:
+        audit=[{'check':'TIMING_ASSERTION','specimen_uid':sp['specimen_uid'],'precision':'EXACT',
+            'relative_day':sp['days_from_index_start'],'canonical_category':sp['canonical_timing_category'],
+            'treatment_episode_id':'E1','binding_id':'bind'+sp['specimen_uid'],'role':'PRE_INDEX_BASELINE' if sp['days_from_index_start']<0 else 'ON_TREATMENT','interval':[None,None]} for sp in p['records'].get('specimen_registry',[])]
+        p['dependencies']['timing']=finish('timing',{**p,'dependencies':{}},p['records'],audit=audit,schemas=STORE)
+    return p
