+def _candidates(records: dict[str,Any], patient: dict[str,Any], ep: dict[str,Any], cfg: dict[str,Any],
+                *, baseline: bool, audit: list[dict[str,Any]]) -> list[tuple[dict[str,Any],dict[str,Any]]]:
+    selected=[]
