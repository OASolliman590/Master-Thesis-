+
+def _release_draft(packet: dict[str,Any], deps: dict[str,Any], store: SchemaStore) -> dict[str,Any]:
+    cfg=packet['config']['freeze']
+    row={'schema_version':'1.1.0','release_id':'synthetic-'+digest(packet)[:24],'branch_id':packet['branch_id'],
+        'state':'READY_FOR_REVIEW','evidence_class':'SYNTHETIC','source_universe_version':cfg['source_universe_version'],
+        'required_source_ids':cfg['required_source_ids'],'admitted_source_ids':[],
+        'requires_final_test':packet['branch_id']=='A_P2_FINAL_TEST','software_gate':'PASS','data_gate':'NOT_RUN',
+        'statistical_gate':'NOT_RUN','protected_set_gate':'NOT_RUN','admission_receipt_ids':[],
+        'matrix_build_receipt_ids':[],'config_sha256':digest(packet['config']),
+        'environment_sha256':digest(cfg['environment']),'split_sha256':deps['split']['receipt_id'],
+        'model_sha256':None,'weight_registry_sha256':None,'reviewer':None,'reviewed_utc':None,
