+        return "SUPPORTED" if any(r["canonical_timing_category"] == "PRE_INDEX_BASELINE" and r["baseline_candidate_status"] == "YES" and r["biological_compartment"] == "TUMOUR" for r in rows) else "UNKNOWN"
