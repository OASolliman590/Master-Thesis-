+    records=copy.deepcopy(packet['records']);patients={p['patient_uid']:p for p in records.get('patient_registry',[])}
+    assigned: dict[str,dict[str,Any]] = {}
+    for row in rows:
+        # Schema rejects a final-test row with nested folds before policy is considered.
+        store.validate('split',row)
