+                require(exposure['use'] not in {'MOLECULAR_RESPONSE_INSPECTION','DIFFERENTIAL_EXPRESSION','PROGRAMME_LEARNING','FEATURE_SELECTION','MODEL_TUNING','THRESHOLD_SELECTION','PUBLISHED_COMPARATOR_DEVELOPMENT','FINAL_TEST_EVALUATION','PROSTATE_TRANSFER'},'PRIOR_MODEL_EXPOSURE')
