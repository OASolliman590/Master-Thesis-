+@stage_boundary("workflow")
+def run_workflow(packet: dict[str, Any], destination: Path | None = None, *,
+                 schemas: SchemaStore | None = None) -> dict[str, Any]:
+    """Run the connected synthetic DAG, stopping before any blocked descendant.
