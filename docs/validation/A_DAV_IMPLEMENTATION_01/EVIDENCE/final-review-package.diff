+            require(subject["regimen_id"] == episode["regimen_id"], "TREATMENT_SEQUENCE_CONFLICT")
+            require(subject["prior_ici"] == episode["prior_ici"] or "UNKNOWN" in {subject["prior_ici"], episode["prior_ici"]}, "TREATMENT_SEQUENCE_CONFLICT")
+            component_days: dict[str, float] = {}
+            for field in ("start_date_or_day", "stop_date_or_day"):
+                if subject.get(field) is None:
+                    unknown_component_timing = True
+                    continue
+                try:
+                    parsed = float(subject[field])
+                except ValueError:
+                    unknown_component_timing = True
+                    continue
+                require(math.isfinite(parsed), "COLLECTION_CHRONOLOGY_CONFLICT")
+                component_days[field] = parsed
+                if _number(episode.get("start_day")):
+                    require(parsed >= episode["start_day"], "COLLECTION_CHRONOLOGY_CONFLICT")
+                if _number(episode.get("stop_day")):
+                    require(parsed <= episode["stop_day"], "COLLECTION_CHRONOLOGY_CONFLICT")
+            if len(component_days) == 2:
+                require(component_days["start_date_or_day"] <= component_days["stop_date_or_day"], "COLLECTION_CHRONOLOGY_CONFLICT")
