{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/paper-c/query_handoff.schema.json",
  "title": "Paper C query handoff row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id", "query_version", "query_type", "query_hash", "programme_id",
    "gene_id", "gene_annotation_release", "desired_direction", "selection_rank",
    "source_patient_set", "discovery_split", "clinical_effect", "prostate_expression_effect",
    "methylation_support", "composition_sensitivity", "cellular_localisation",
    "prior_outcome_exposure", "l1000_coverage_tier", "provenance"
  ],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "query_version": {"type": "string", "minLength": 1},
    "query_type": {"enum": ["Q_E", "Q_M"]},
    "query_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "programme_id": {"type": "string", "minLength": 1},
    "gene_id": {"type": "string", "minLength": 1},
    "gene_symbol": {"type": ["string", "null"]},
    "gene_annotation_release": {"type": "string", "minLength": 1},
    "desired_direction": {"enum": ["desired_up", "desired_down"]},
    "selection_rank": {"type": "integer", "minimum": 1},
    "tie_break_key": {"type": ["string", "null"]},
    "source_patient_set": {"type": "string", "minLength": 1},
    "discovery_split": {"type": "string", "minLength": 1},
    "clinical_effect": {"$ref": "#/$defs/effect"},
    "prostate_expression_effect": {"$ref": "#/$defs/effect"},
    "methylation_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "feature_id", "region", "effect", "model", "multiplicity_rule"],
      "properties": {
        "status": {"enum": ["supported", "not_supported", "not_tested", "unknown"]},
        "feature_id": {"type": ["string", "null"]},
        "region": {"enum": ["promoter", "enhancer", "gene_body", "domain", "other", "unknown"]},
        "effect": {"anyOf": [{"$ref": "#/$defs/effect"}, {"type": "null"}]},
        "model": {"type": ["string", "null"]},
        "multiplicity_rule": {"type": ["string", "null"]}
      }
    },
    "composition_sensitivity": {"enum": ["stable", "attenuated", "strengthened", "discordant", "not_tested", "unknown"]},
    "cellular_localisation": {"enum": ["tumour_supported", "immune_supported", "stromal_supported", "mixed", "unknown"]},
    "genetic_alternatives": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prior_outcome_exposure": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "l1000_coverage_tier": {"enum": ["landmark", "best_inferred", "other_inferred", "absent", "not_assessed"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "config_hash", "created_utc"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "created_utc": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "standard_error", "p_value", "q_value", "contrast", "scale"],
      "properties": {
        "estimate": {"type": ["number", "null"]},
        "standard_error": {"type": ["number", "null"], "minimum": 0},
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "q_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "contrast": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1}
      }
    }
  }
}
