{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Treatment schedule",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "schedule_id": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "time_value": {
            "type": "number",
            "minimum": 0
          },
          "time_unit": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "perturbation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "dose_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "dose_unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "time_value",
          "time_unit",
          "action",
          "perturbation_id",
          "dose_value",
          "dose_unit"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "schedule_id",
    "context_id",
    "events",
    "status"
  ],
  "additionalProperties": false
}
