{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Molecular-to-phenotype mapping",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "mapping_id": {
      "type": "string"
    },
    "cell_type": {
      "type": "string"
    },
    "programme": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "behaviour": {
      "type": "string"
    },
    "direction": {
      "type": "string"
    },
    "mapping_function": {
      "type": "string"
    },
    "parameter_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "string"
    },
    "calibration_source": {
      "type": "string"
    },
    "validation_source": {
      "type": "string"
    },
    "claim_limit": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "mapping_id",
    "cell_type",
    "programme",
    "features",
    "behaviour",
    "direction",
    "mapping_function",
    "parameter_ids",
    "evidence",
    "uncertainty",
    "calibration_source",
    "validation_source",
    "claim_limit",
    "status"
  ],
  "additionalProperties": false
}
