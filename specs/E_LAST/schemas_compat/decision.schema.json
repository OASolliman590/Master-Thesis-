{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-e:schema:decision:1.0.0",
  "title": "decision",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "decision_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "APPROVED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "owner_role": {
      "type": "string"
    },
    "resolution_evidence": {
      "type": "string"
    },
    "consequence": {
      "type": "string"
    },
    "affected_packets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_value": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "synthetic",
    "decision_id",
    "question",
    "status",
    "owner_role",
    "resolution_evidence",
    "consequence",
    "affected_packets",
    "approved_value"
  ],
  "additionalProperties": false
}
