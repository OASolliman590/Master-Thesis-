{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-e:schema:parameter_evidence:1.0.0",
  "title": "parameter_evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "parameter_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "measurement": {
      "type": "object",
      "properties": {
        "raw_value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "raw_unit": {
          "type": "string"
        },
        "canonical_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "canonical_unit": {
          "type": "string"
        },
        "statistic": {
          "enum": [
            "individual",
            "arithmetic_mean",
            "geometric_mean",
            "median",
            "fraction",
            "count",
            "fitted_estimate",
            "annotation",
            "unknown"
          ]
        },
        "biological_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "biological_unit": {
          "type": "string"
        },
        "n_unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "SD",
                "SE",
                "CI",
                "digitization",
                "posterior",
                "range",
                "unknown",
                "none"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "lower": {
              "type": [
                "number",
                "null"
              ]
            },
            "upper": {
              "type": [
                "number",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value",
            "lower",
            "upper",
            "reason"
          ],
          "additionalProperties": false
        },
        "transformation": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversion_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "raw_statistic": {
          "enum": [
            "individual",
            "arithmetic_mean",
            "geometric_mean",
            "median",
            "fraction",
            "count",
            "fitted_estimate",
            "annotation",
            "unknown"
          ]
        },
        "raw_uncertainty_type": {
          "enum": [
            "SD",
            "SE",
            "CI",
            "digitization",
            "posterior",
            "range",
            "unknown",
            "none"
          ]
        }
      },
      "required": [
        "raw_value",
        "raw_unit",
        "canonical_value",
        "canonical_unit",
        "statistic",
        "biological_n",
        "biological_unit",
        "n_unknown_reason",
        "uncertainty",
        "transformation",
        "conversion_factor",
        "raw_statistic",
        "raw_uncertainty_type"
      ],
      "additionalProperties": false
    },
    "evidence_class": {
      "enum": [
        "measured_observation",
        "reported_summary",
        "digitization",
        "annotation",
        "fitted_estimate",
        "prior",
        "assumption",
        "hypothesis",
        "prediction",
        "extrapolation"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_locator": {
      "type": "string"
    },
    "parameter_status": {
      "enum": [
        "source_reported",
        "source_fitted",
        "prior_proposed",
        "estimated",
        "unresolved"
      ]
    },
    "prior_definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "curator": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "permitted_role": {
      "enum": [
        "exploratory_qualification",
        "calibration",
        "model_selection",
        "independent_public_evaluation",
        "prospective_internal_validation",
        "contextual_corroboration",
        "upstream_reconstruction",
        "unassigned"
      ]
    },
    "transferability": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "synthetic",
    "parameter_id",
    "symbol",
    "context",
    "measurement",
    "evidence_class",
    "source_ids",
    "source_locator",
    "parameter_status",
    "prior_definition",
    "curator",
    "verification",
    "permitted_role",
    "transferability"
  ],
  "additionalProperties": false
}
