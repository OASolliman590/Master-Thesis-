      "required": [
        "exposure_events",
        "tumour_viability",
        "tumour_target_counts",
        "proximal_engagement",
        "molecular_endpoint",
        "protein_endpoint",
        "tumour_timecourse",
        "tumour_withdrawal_series",
        "immune_viability",
        "immune_function",
        "immune_timecourse",
        "immune_withdrawal_series",
        "target_specific_killing",
        "compartment_controls",
        "checkpoint_qualified",
        "schedule_arms",
        "analytical_exposure",
        "variation_estimated",
        "population_targets_qualified"
