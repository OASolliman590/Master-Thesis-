      "const": "2.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "data_state": {
      "enum": [
        "NONE",
        "PLANNED",
        "APPROVED",
        "GENERATED",
        "QUALITY_CHECKED",
        "ADMITTED",
        "WITHDRAWN"
      ]
    },
    "permission": {
      "enum": [
        "APPROVED",
        "UNKNOWN",
        "DENIED",
        "WITHDRAWN"
      ]
    },
    "qc": {
      "enum": [
        "PASSED",
        "PENDING",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "identity_verified": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "biological_units_known": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "context_compatible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "assay_mapping_reviewed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure_events": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tumour_viability": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tumour_target_counts": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "proximal_engagement": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "molecular_endpoint": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "protein_endpoint": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tumour_timecourse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tumour_withdrawal_series": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "immune_viability": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "immune_function": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "immune_timecourse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "immune_withdrawal_series": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "target_specific_killing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "compartment_controls": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "checkpoint_qualified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "schedule_arms": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "analytical_exposure": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "variation_estimated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "population_targets_qualified": {
          "type": [
            "boolean",
            "null"
          ]
        }
