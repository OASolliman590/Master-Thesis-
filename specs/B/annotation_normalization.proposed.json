      "tcga_gencode_v36",
      "gse107299_processed",
      "historical_v18_maps"
    ]
  },
  "scientific_boundaries": {
    "selected_primary": "B-P",
    "primary_membership_frozen": false,
    "universe_u_frozen": false,
    "promoter_q_defined": false,
    "specimen_policy_resolved": false,
    "covariate_policy_resolved": false,
    "precision_resolved": false,
    "may_score_program": false,
    "may_select_genes": false,
    "may_view_cpc_outcomes": false,
    "may_claim_measurement_specificity": false,
    "may_claim_cross_platform_transport": false,
    "may_release_biological_analysis": false,
    "synthetic_fixtures_validate_biology": false,
    "historical_availability_equals_redistribution_permission": false
  },
  "access_boundaries": {
    "network_during_prepare": false,
    "git_may_contain_source_databases": false,
    "git_may_contain_patient_values": false,
    "committed_private_paths_allowed": false,
    "credentials_allowed": false,
    "patient_sample_expression_values_in_plan": false,
    "large_objects_storage": "outside_git_approved_aiu_or_outer_audit_cache"
  },
  "canonicalization": {
    "authority": "NCBI Gene current symbols and aliases, reviewed 2026-09-10",
    "authority_date": "2026-09-10",
    "live_lookup_at_convert_time": false,
    "alias_rules": [
      {"raw_symbol": "MB21D1", "canonical_symbol": "CGAS", "evidence": "NCBI Gene alias reviewed 2026-09-10"},
      {"raw_symbol": "TMEM173", "canonical_symbol": "STING1", "evidence": "NCBI Gene alias reviewed 2026-09-10"},
      {"raw_symbol": "TAPBPR", "canonical_symbol": "TAPBPL", "evidence": "NCBI Gene alias reviewed 2026-09-10"}
    ],
    "do_not_collapse": [["TAPBP", "TAPBPL"]],
    "matching": "exact_case_sensitive_raw_token"
  },
  "output_contract": {
    "table_encoding": "uncompressed_utf8_tsv_lf_no_bom",
    "header": ["raw_id", "canonical_symbol", "entrez_id", "ensembl_id", "mapping_status"],
    "mapping_status_enum": ["mapped", "ambiguous", "unmapped"],
    "mapped_requires_nonempty_canonical_symbol": true,
    "mapped_requires_entrez_or_ensembl": true,
    "unmapped_identifier_fields_empty": true,
    "ambiguous_retains_source_candidates_without_resolution": true,
    "empty_cell_token": "",
    "forbid_na_null_nan_tokens": true,
    "preserve_raw_id": true,
    "forbid_patient_value_sample_expression_columns": true,
    "identifier_namespace": "symbol_entrez_ensembl",
    "b_g1_manifest_schema_version": "B-G1-annotation-manifest-v1",
    "pinned_requires_freeze_receipt": true,
    "row_order": ["raw_id", "mapping_status", "canonical_symbol", "entrez_id", "ensembl_id"],
    "hash_algorithm": "sha256",
    "hash_payload": "exact uncompressed UTF-8 bytes of the written TSV"
  },
  "mapping_rules": {
    "no_abundance_or_outcome_selection": {
      "rule_id": "BG2-R01",
      "machine_status": "proposed",
      "forbidden_selectors": ["expression_magnitude", "patient_coverage", "outcome", "effect", "convenience"]
    },
    "missing_native_identifiers": {
      "rule_id": "BG2-R02",
      "machine_status": "proposed",
      "action": "unmapped_preserve_raw_id"
    },
    "retired_or_null_native_map": {
      "rule_id": "BG2-R03",
      "machine_status": "proposed",
      "action": "unmapped_preserve_raw_id_do_not_fill_from_conflicting_table"
    },
    "ambiguous_one_raw_to_many_candidates": {
      "rule_id": "BG2-R04",
      "machine_status": "proposed",
      "action": "one_row_per_candidate_mapping_status_ambiguous",
      "packed_delimiter_in_cell": null,
      "packed_delimiter_reason": "B-G1 does not define a multi-value delimiter"
    },
    "many_raw_to_one_symbol": {
      "rule_id": "BG2-R05",
      "machine_status": "proposed",
      "action": "retain_all_rows"
    },
    "duplicate_exact_rows": {
      "rule_id": "BG2-R06",
      "machine_status": "proposed",
      "action": "fail_closed"
    },
    "hla_symbol_caution": {
      "rule_id": "BG2-R07",
      "machine_status": "proposed",
      "action": "sidecar_hla_caution_do_not_drop_or_prefer_by_abundance",
      "symbol_prefix": "HLA-"
    },
    "alias_application": {
      "rule_id": "BG2-R08",
      "machine_status": "proposed",
      "action": "apply_registry_aliases_to_canonical_symbol_only"
    }
  },
  "freeze_gates": {
    "receipt_schema_version": "B-G2-source-freeze-receipt-v1",
    "required_before_pinned": true,
    "pin_authorized_field": "pin_authorized",
    "receipt_must_bind_plan_sha256": true,
    "receipt_must_bind_schema_sha256": true,
    "unknown_hashes_must_be_null": true,
    "unknown_paths_must_be_null": true,
    "redistribution_default": "not_adjudicated",
    "source_reference_is_deterministic": true,
    "validation_by_standard_library_only": true
  },
  "input_contract": {
    "mode": "repeatable_input_role_path",
    "inputs": [
      {"source_id": "tcga_gencode_v36", "role": "tcga_gencode_v36", "cardinality": 1},
      {"source_id": "gse107299_processed", "role": "gse107299_processed", "cardinality": 1},
      {"source_id": "historical_v18_maps", "role": "hta20", "chip": "hta20", "cardinality": 1},
      {"source_id": "historical_v18_maps", "role": "hugene20st", "chip": "hugene20st", "cardinality": 1}
    ]
  },
  "source_reference_rendering": {
    "template": "B-G2|{source_id}|{purpose}|{plan_sha256}|{schema_sha256}|{ordered_role_sha256_pairs}|{reviewed_utc}",
    "components": [
      "source_id",
      "purpose",
      "plan_sha256",
      "schema_sha256",
      "ordered_role_sha256_pairs",
      "reviewed_utc"
    ],
    "allows_credentials": false
  },
  "freeze_receipt_contract": {
    "schema_version": "B-G2-source-freeze-receipt-v1",
    "additional_properties_allowed": false,
    "production_purpose": "source_freeze",
    "synthetic_purpose": "synthetic_test",
    "production_pin_authorized": true,
    "required_top_level_fields": [
      "schema_version",
      "purpose",
      "source_id",
      "pin_authorized",
      "plan_sha256",
      "schema_sha256",
      "inputs",
      "reviewer_id",
      "reviewer_identity",
      "reviewed_utc",
      "notes"
    ],
    "input_descriptor_fields": [
      "role",
      "object_name",
      "byte_count",
      "sha256",
      "retrieved_utc",
      "exact_url",
      "access_class",
      "completeness",
      "redistribution",
      "committed_path"
    ],
    "input_access_class": "public",
    "ordered_inputs_required": true,
    "production_output": "pinned_b_g1_manifest_and_complete",
    "synthetic_output": "validation_receipt_only_never_b_g1_manifest_or_complete"
  },
