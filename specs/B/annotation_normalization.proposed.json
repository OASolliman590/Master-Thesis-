{
  "$schema": "./annotation_normalization.schema.json",
  "schema_version": "B-G2-annotation-normalization-proposed-v1",
  "ticket_id": "B-G2",
  "status": "proposed_not_frozen",
  "plan_kind": "machine_checkable_preparation_plan",
  "normalized_export_emitted": false,
  "any_source_status_pinned": false,
