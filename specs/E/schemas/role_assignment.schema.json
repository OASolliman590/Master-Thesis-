{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-e:schema:role_assignment:1.0.0",
  "title": "role_assignment",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "assignment_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "group_type": {
      "enum": [
        "study",
        "experiment",
        "donor",
        "population"
      ]
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "enum": [
        "exploratory_qualification",
        "calibration",
        "model_selection",
        "independent_public_evaluation",
        "prospective_internal_validation",
        "contextual_corroboration",
        "upstream_reconstruction",
        "unassigned"
      ]
    },
    "assigned_at": {
      "type": "string"
    },
    "outcome_access": {
      "type": "string"
    },
    "freeze_reference": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "synthetic",
    "assignment_id",
    "model_version",
    "group_id",
    "group_type",
    "object_ids",
    "role",
    "assigned_at",
    "outcome_access",
    "freeze_reference"
  ],
  "additionalProperties": false
}
