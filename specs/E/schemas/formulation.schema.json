{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-e:schema:formulation:1.0.0",
  "title": "formulation",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "formulation_id": {
      "type": "string"
    },
    "compound_id": {
      "type": "string"
    },
    "parent_salt": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "form": {
      "type": "string"
    },
    "dose_basis": {
      "type": "string"
    },
    "vehicle": {
      "type": "string"
    },
    "supplier_lot_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_grade_status": {
      "enum": [
        "verified",
        "planned",
        "unknown"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "synthetic",
    "formulation_id",
    "compound_id",
    "parent_salt",
    "route",
    "form",
    "dose_basis",
    "vehicle",
    "supplier_lot_reference",
    "research_grade_status",
    "evidence_ids"
  ],
  "additionalProperties": false
}
