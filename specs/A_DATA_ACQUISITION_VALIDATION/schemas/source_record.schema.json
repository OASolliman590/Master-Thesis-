{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OASolliman590/Master-Thesis-/main/specs/A_DATA_ACQUISITION_VALIDATION/schemas/source_record.schema.json",
  "title": "Source object record",
  "description": "Patient-free record for one exact retrievable object. Null hash is required before full retrieval rather than an invented digest.",
  "type": "object",
  "required": [
    "source_object_id",
    "study_id",
    "publication_family_id",
    "repository",
    "object_type",
    "exact_file_name",
    "retrieval_status",
    "validation_status",
    "source_locators"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "source_object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "publication_family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "repository": {
      "type": "string"
    },
    "accession": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_route": {
      "type": "string",
      "enum": [
        "PUBLIC_DIRECT",
        "PUBLIC_LANDING",
        "CONTROLLED",
        "AUTHOR_REQUEST",
        "UNAVAILABLE",
        "UNKNOWN"
      ]
    },
    "object_type": {
      "type": "string"
    },
    "exact_file_name": {
      "type": "string"
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieval_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "byte_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash_scope": {
      "type": "string",
      "enum": [
        "FULL_OBJECT",
        "COMPRESSED_PREFIX",
        "HEADER_ONLY",
        "NOT_RETRIEVED"
      ]
    },
    "compression": {
      "type": [
        "string",
        "null"
      ]
    },
    "modality": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "genome_build": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_identifier_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "measurement_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "transform": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalisation": {
      "type": [
        "string",
        "null"
      ]
    },
    "batch_correction": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_selection": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome_aware_processing": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "patient_sample_crosswalk": {
      "type": "string",
      "enum": [
        "AVAILABLE_VERIFIED",
        "AVAILABLE_UNVERIFIED",
        "ABSENT",
        "UNKNOWN"
      ]
    },
    "license_terms": {
      "type": [
        "string",
        "null"
      ]
    },
    "redistribution_status": {
      "type": "string",
      "enum": [
        "PERMITTED",
        "NOT_PERMITTED",
        "UNCLEAR",
        "CONTROLLED",
        "UNKNOWN"
      ]
    },
    "retrieval_status": {
      "type": "string",
      "enum": [
        "NOT_ATTEMPTED",
        "LOCATED",
        "PARTIAL",
        "RETRIEVED",
        "FAILED",
        "CONTROLLED_PENDING",
        "UNAVAILABLE"
      ]
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "NOT_VALIDATED",
        "STRUCTURAL_ONLY",
        "PASS",
        "FAIL",
        "BLOCKED_UNKNOWN"
      ]
    },
    "exclusion_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "page_or_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_utc": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
