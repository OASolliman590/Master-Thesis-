{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://raw.githubusercontent.com/OASolliman590/Master-Thesis-/main/specs/A_DATA_ACQUISITION_VALIDATION/schemas/prior_exposure_record.schema.json",
 "title":"Prior exposure by source, fields, purpose and model lineage",
 "type":"object","additionalProperties":false,
 "required":["schema_version","exposure_id","subject_type","subject_id","analysis_lineage_id","fields_accessed","use","occurred_utc","date_precision","actor_role","independence_implication","source_locators"],
 "properties":{
  "schema_version":{"const":"1.1.0"},"exposure_id":{"type":"string","minLength":1},
  "subject_type":{"enum":["STUDY_FAMILY","SOURCE_OBJECT","PATIENT_SET","SPECIMEN_SET","COMPARATOR_TRAINING_SET"]},
  "subject_id":{"type":"string","minLength":1},"analysis_lineage_id":{"type":"string","minLength":1},
  "fields_accessed":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
  "use":{"enum":["METADATA_INSPECTION","CLINICAL_ENDPOINT_CURATION","CLASS_COUNT_PLANNING","MOLECULAR_RESPONSE_INSPECTION","DIFFERENTIAL_EXPRESSION","PROGRAMME_LEARNING","FEATURE_SELECTION","MODEL_TUNING","THRESHOLD_SELECTION","FINAL_TEST_EVALUATION","PROSTATE_TRANSFER","PUBLISHED_COMPARATOR_DEVELOPMENT","UNKNOWN"]},
  "occurred_utc":{"type":["string","null"]},"date_precision":{"enum":["EXACT","APPROXIMATE","UNKNOWN"]},
  "actor_role":{"type":"string","minLength":1},
  "independence_implication":{"enum":["METADATA_ONLY_REVIEWED","BLOCKS_UNTOUCHED_FOR_LINEAGE","REVIEW_REQUIRED","AUTHORIZED_FROZEN_EVALUATION"]},
  "source_locators":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
  "reviewer":{"type":["string","null"]},"notes":{"type":["string","null"]}
 },
 "allOf":[
  {"if":{"properties":{"use":{"enum":["MOLECULAR_RESPONSE_INSPECTION","DIFFERENTIAL_EXPRESSION","PROGRAMME_LEARNING","FEATURE_SELECTION","MODEL_TUNING","THRESHOLD_SELECTION","PUBLISHED_COMPARATOR_DEVELOPMENT"]}}},"then":{"properties":{"independence_implication":{"enum":["BLOCKS_UNTOUCHED_FOR_LINEAGE","REVIEW_REQUIRED"]}}}},
  {"if":{"properties":{"use":{"const":"UNKNOWN"}}},"then":{"properties":{"independence_implication":{"const":"REVIEW_REQUIRED"}}}}
 ]
}
