{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://raw.githubusercontent.com/OASolliman590/Master-Thesis-/main/specs/A_DATA_ACQUISITION_VALIDATION/schemas/materialized_matrix.schema.json",
 "title":"Seven analysis-specific materialized record contracts, shared authority 1.1.0",
 "description":"Views of normalized records, not a patient store. Foreign-key, equality, count and holdout invariants require the relational validator.",
 "oneOf":[{"$ref":"#/$defs/baseline"},{"$ref":"#/$defs/timepoint"},{"$ref":"#/$defs/pair"},{"$ref":"#/$defs/endpoint"},{"$ref":"#/$defs/coverage"},{"$ref":"#/$defs/split"},{"$ref":"#/$defs/membership"}],
 "$defs":{
  "id":{"type":"string","minLength":1},
  "nullable_id":{"type":["string","null"],"minLength":1},
  "binary":{"type":["integer","null"],"enum":[0,1,null]},
  "private":{"enum":["PRIVATE_PATIENT_LEVEL","SYNTHETIC_ONLY"]},
  "category":{"enum":["CR","PR","SD","PD","NE","UNK","SOURCE_BINARY","NOT_APPLICABLE"]},
  "status":{"enum":["INCLUDED","EXCLUDED","BLOCKED_UNKNOWN"]},
  "baseline":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","data_classification","patient_uid","study_id","cancer","subtype","treatment_episode_id","regimen_id","treatment_class","prior_ici","prior_treatment","specimen_uid","assay_uid","expression_column","biopsy_site","raw_response","response_system","canonical_category","orr","dcr","endpoint_evaluability","inclusion_status","exclusion_reason","expression_unit","feature_annotation","branch_id","split_role","prior_exposure_status","build_receipt_id"],
   "properties":{
    "row_type":{"const":"BASELINE"},"schema_version":{"const":"1.1.0"},"data_classification":{"$ref":"#/$defs/private"},
    "patient_uid":{"$ref":"#/$defs/id"},"study_id":{"$ref":"#/$defs/id"},"cancer":{"type":"string","minLength":1},"subtype":{"type":["string","null"]},
    "treatment_episode_id":{"$ref":"#/$defs/nullable_id"},"regimen_id":{"$ref":"#/$defs/nullable_id"},"treatment_class":{"type":["string","null"]},"prior_ici":{"enum":["YES","NO","UNKNOWN"]},"prior_treatment":{"type":["string","null"]},
    "specimen_uid":{"$ref":"#/$defs/nullable_id"},"assay_uid":{"$ref":"#/$defs/nullable_id"},"expression_column":{"type":["string","null"]},"biopsy_site":{"type":["string","null"]},
    "raw_response":{"type":["string","null"]},"response_system":{"type":["string","null"]},"canonical_category":{"$ref":"#/$defs/category"},"orr":{"$ref":"#/$defs/binary"},"dcr":{"$ref":"#/$defs/binary"},
    "endpoint_evaluability":{"enum":["EVALUABLE","NOT_EVALUABLE","UNKNOWN"]},"inclusion_status":{"$ref":"#/$defs/status"},"exclusion_reason":{"type":["string","null"]},
    "expression_unit":{"type":["string","null"]},"feature_annotation":{"type":["string","null"]},"branch_id":{"$ref":"#/$defs/id"},"split_role":{"type":"string","minLength":1},"prior_exposure_status":{"type":"string","minLength":1},"build_receipt_id":{"$ref":"#/$defs/id"}
   },
   "allOf":[{"if":{"properties":{"inclusion_status":{"const":"INCLUDED"}}},"then":{"properties":{"treatment_episode_id":{"$ref":"#/$defs/id"},"specimen_uid":{"$ref":"#/$defs/id"},"assay_uid":{"$ref":"#/$defs/id"},"expression_column":{"type":"string","minLength":1},"expression_unit":{"type":"string","minLength":1},"feature_annotation":{"type":"string","minLength":1}}},"else":{"properties":{"exclusion_reason":{"type":"string","minLength":1}}}}]
  },
  "timepoint":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","data_classification","patient_uid","study_id","specimen_uid","assay_uid","treatment_episode_id","raw_timing_label","canonical_timing","relative_day","timing_precision","lesion_site","outcome_id","endpoint_assessment_day","pairability","missingness_reason","build_receipt_id"],
   "properties":{
    "row_type":{"const":"TIMEPOINT"},"schema_version":{"const":"1.1.0"},"data_classification":{"$ref":"#/$defs/private"},"patient_uid":{"$ref":"#/$defs/id"},"study_id":{"$ref":"#/$defs/id"},"specimen_uid":{"$ref":"#/$defs/id"},"assay_uid":{"$ref":"#/$defs/nullable_id"},"treatment_episode_id":{"$ref":"#/$defs/nullable_id"},
    "raw_timing_label":{"type":["string","null"]},"canonical_timing":{"enum":["PRE_INDEX_BASELINE","EARLY_ON_TREATMENT","LATE_ON_TREATMENT","RESPONSE_ASSESSMENT","MAXIMAL_RESPONSE","PROGRESSION","POST_TREATMENT","POST_DISCONTINUATION","AFTER_REGIMEN_CHANGE","UNKNOWN"]},"relative_day":{"type":["number","null"]},"timing_precision":{"enum":["EXACT","BOUNDED_INTERVAL","SOURCE_CATEGORY","UNKNOWN"]},"lesion_site":{"type":["string","null"]},"outcome_id":{"$ref":"#/$defs/nullable_id"},"endpoint_assessment_day":{"type":["number","null"]},"pairability":{"enum":["PAIRABLE","NOT_PAIRABLE","UNKNOWN"]},"missingness_reason":{"type":["string","null"]},"build_receipt_id":{"$ref":"#/$defs/id"}
   },
   "allOf":[{"if":{"properties":{"timing_precision":{"const":"EXACT"}}},"then":{"properties":{"relative_day":{"type":"number"}}}}]
  },
  "pair":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","data_classification","patient_uid","study_id","treatment_episode_id","contrast_id","window_id","response_group","regimen_id","pre_specimen_uid","pre_assay_uid","followup_specimen_uid","followup_assay_uid","pre_day","followup_day","followup_category","same_lesion","same_platform","pair_quality","inclusion_status","exclusion_reason","missing_followup_reason","build_receipt_id"],
   "properties":{
    "row_type":{"const":"PAIR"},"schema_version":{"const":"1.1.0"},"data_classification":{"$ref":"#/$defs/private"},"patient_uid":{"$ref":"#/$defs/id"},"study_id":{"$ref":"#/$defs/id"},"treatment_episode_id":{"$ref":"#/$defs/id"},"contrast_id":{"$ref":"#/$defs/id"},"window_id":{"$ref":"#/$defs/id"},"response_group":{"enum":["R","NR","UNKNOWN","NOT_APPLICABLE"]},"regimen_id":{"$ref":"#/$defs/id"},"pre_specimen_uid":{"$ref":"#/$defs/nullable_id"},"pre_assay_uid":{"$ref":"#/$defs/nullable_id"},"followup_specimen_uid":{"$ref":"#/$defs/nullable_id"},"followup_assay_uid":{"$ref":"#/$defs/nullable_id"},"pre_day":{"type":["number","null"]},"followup_day":{"type":["number","null"]},"followup_category":{"type":"string","minLength":1},"same_lesion":{"type":["boolean","null"]},"same_platform":{"type":["boolean","null"]},"pair_quality":{"enum":["VERIFIED","QUALIFIED_DIFFERENT_LESION","QUALIFIED_MEASUREMENT_BRIDGE","BLOCKED_UNKNOWN","EXCLUDED"]},"inclusion_status":{"$ref":"#/$defs/status"},"exclusion_reason":{"type":["string","null"]},"missing_followup_reason":{"type":["string","null"]},"build_receipt_id":{"$ref":"#/$defs/id"}
   },
   "allOf":[{"if":{"properties":{"inclusion_status":{"const":"INCLUDED"}}},"then":{"properties":{"pre_specimen_uid":{"$ref":"#/$defs/id"},"pre_assay_uid":{"$ref":"#/$defs/id"},"followup_specimen_uid":{"$ref":"#/$defs/id"},"followup_assay_uid":{"$ref":"#/$defs/id"},"pair_quality":{"enum":["VERIFIED","QUALIFIED_DIFFERENT_LESION","QUALIFIED_MEASUREMENT_BRIDGE"]}}},"else":{"properties":{"exclusion_reason":{"type":"string","minLength":1}}}}]
  },
  "endpoint":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","data_classification","patient_uid","treatment_episode_id","outcome_id","endpoint_id","endpoint_class","raw_value","canonical_category","assessment_system","assessment_day","binary_value","duration_threshold","event_time","event_indicator","censoring","evaluability","mapping_version","source_locator","build_receipt_id"],
   "properties":{
    "row_type":{"const":"ENDPOINT"},"schema_version":{"const":"1.1.0"},"data_classification":{"$ref":"#/$defs/private"},"patient_uid":{"$ref":"#/$defs/id"},"treatment_episode_id":{"$ref":"#/$defs/id"},"outcome_id":{"$ref":"#/$defs/id"},"endpoint_id":{"$ref":"#/$defs/id"},"endpoint_class":{"enum":["ORR","DCR","DCB","PSA_RESPONSE","PATHOLOGICAL_RESPONSE","PFS","OS","SOURCE_BINARY_UNKNOWN","OTHER"]},"raw_value":{"type":["string","null"]},"canonical_category":{"$ref":"#/$defs/category"},"assessment_system":{"type":["string","null"]},"assessment_day":{"type":["number","null"]},"binary_value":{"$ref":"#/$defs/binary"},"duration_threshold":{"type":["number","null"],"minimum":0},"event_time":{"type":["number","null"],"minimum":0},"event_indicator":{"$ref":"#/$defs/binary"},"censoring":{"type":["string","null"]},"evaluability":{"enum":["EVALUABLE","NOT_EVALUABLE","UNKNOWN"]},"mapping_version":{"$ref":"#/$defs/id"},"source_locator":{"type":"string","minLength":1},"build_receipt_id":{"$ref":"#/$defs/id"}
   },
   "allOf":[
    {"if":{"properties":{"endpoint_class":{"const":"ORR"},"canonical_category":{"enum":["CR","PR"]},"evaluability":{"const":"EVALUABLE"}}},"then":{"properties":{"binary_value":{"const":1}}}},
    {"if":{"properties":{"endpoint_class":{"const":"ORR"},"canonical_category":{"enum":["SD","PD"]},"evaluability":{"const":"EVALUABLE"}}},"then":{"properties":{"binary_value":{"const":0}}}},
    {"if":{"properties":{"endpoint_class":{"const":"DCR"},"canonical_category":{"enum":["CR","PR","SD"]},"evaluability":{"const":"EVALUABLE"}}},"then":{"properties":{"binary_value":{"const":1}}}},
    {"if":{"properties":{"endpoint_class":{"const":"DCR"},"canonical_category":{"const":"PD"},"evaluability":{"const":"EVALUABLE"}}},"then":{"properties":{"binary_value":{"const":0}}}},
    {"if":{"properties":{"endpoint_class":{"enum":["ORR","DCR"]},"canonical_category":{"enum":["NE","UNK","NOT_APPLICABLE"]}}},"then":{"properties":{"binary_value":{"const":null},"evaluability":{"enum":["NOT_EVALUABLE","UNKNOWN"]}}}},
    {"if":{"properties":{"endpoint_class":{"const":"SOURCE_BINARY_UNKNOWN"}}},"then":{"properties":{"binary_value":{"const":null},"evaluability":{"enum":["NOT_EVALUABLE","UNKNOWN"]}}}},
    {"if":{"properties":{"endpoint_class":{"const":"DCB"},"evaluability":{"const":"EVALUABLE"}}},"then":{"properties":{"duration_threshold":{"type":"number","minimum":0}}}}
   ]
  },
  "coverage":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","study_id","assay_uid","branch_id","required_genes","present_genes","missing_genes","ambiguous_genes","annotation_version","expression_unit","measurement_suitability","scoring_suitability","de_suitability","final_test_suitability","source_object_id"],
   "properties":{
    "row_type":{"const":"COVERAGE"},"schema_version":{"const":"1.1.0"},"study_id":{"$ref":"#/$defs/id"},"assay_uid":{"$ref":"#/$defs/id"},"branch_id":{"$ref":"#/$defs/id"},"required_genes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"present_genes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"missing_genes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"ambiguous_genes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"annotation_version":{"type":"string","minLength":1},"expression_unit":{"type":"string","minLength":1},"measurement_suitability":{"enum":["PASS","FAIL","UNKNOWN"]},"scoring_suitability":{"enum":["PASS","FAIL","UNKNOWN"]},"de_suitability":{"enum":["PASS","FAIL","UNKNOWN"]},"final_test_suitability":{"enum":["PASS","FAIL","UNKNOWN"]},"source_object_id":{"$ref":"#/$defs/id"}
   }
  },
  "split":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","data_classification","patient_uid","study_id","independence_family_id","permanent_role","prior_exposure_state","exposure_decision_id","split_version","reason","nested_assignments"],
   "properties":{
    "row_type":{"const":"SPLIT"},"schema_version":{"const":"1.1.0"},"data_classification":{"$ref":"#/$defs/private"},"patient_uid":{"$ref":"#/$defs/id"},"study_id":{"$ref":"#/$defs/id"},"independence_family_id":{"$ref":"#/$defs/id"},"permanent_role":{"enum":["DEVELOPMENT","FINAL_TEST","PREVIOUSLY_INSPECTED_EXTERNAL","A1_ONLY","PROSTATE_TRANSPORT","EXCLUDED","UNKNOWN"]},"prior_exposure_state":{"enum":["ADJUDICATED_UNTOUCHED","METADATA_ONLY","RESPONSE_ASSOCIATED","UNKNOWN"]},"exposure_decision_id":{"$ref":"#/$defs/nullable_id"},"split_version":{"$ref":"#/$defs/id"},"reason":{"type":"string","minLength":1},"nested_assignments":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["evaluation_id","fold_id","role"],"properties":{"evaluation_id":{"$ref":"#/$defs/id"},"fold_id":{"$ref":"#/$defs/id"},"role":{"enum":["TRAIN","INNER_VALIDATION","OUTER_VALIDATION"]}}}}
   },
   "allOf":[{"if":{"properties":{"permanent_role":{"const":"FINAL_TEST"}}},"then":{"properties":{"prior_exposure_state":{"const":"ADJUDICATED_UNTOUCHED"},"exposure_decision_id":{"$ref":"#/$defs/id"},"nested_assignments":{"maxItems":0}}}}]
  },
  "membership":{
   "type":"object","additionalProperties":false,
   "required":["row_type","schema_version","data_classification","patient_uid","branch_id","inclusion_status","reason","admission_receipt_id","build_receipt_id","protected_set_check"],
   "properties":{
    "row_type":{"const":"MEMBERSHIP"},"schema_version":{"const":"1.1.0"},"data_classification":{"$ref":"#/$defs/private"},"patient_uid":{"$ref":"#/$defs/id"},"branch_id":{"$ref":"#/$defs/id"},"inclusion_status":{"$ref":"#/$defs/status"},"reason":{"type":"string","minLength":1},"admission_receipt_id":{"$ref":"#/$defs/nullable_id"},"build_receipt_id":{"$ref":"#/$defs/id"},"protected_set_check":{"enum":["PASS","FAIL","UNKNOWN"]}
   },
   "allOf":[{"if":{"properties":{"inclusion_status":{"const":"INCLUDED"}}},"then":{"properties":{"admission_receipt_id":{"$ref":"#/$defs/id"},"protected_set_check":{"const":"PASS"}}}}]
  }
 }
}
