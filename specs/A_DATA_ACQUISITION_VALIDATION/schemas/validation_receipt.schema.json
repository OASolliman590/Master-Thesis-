{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OASolliman590/Master-Thesis-/main/specs/A_DATA_ACQUISITION_VALIDATION/schemas/validation_receipt.schema.json",
  "title": "Validation receipt",
  "description": "Gate-specific receipt. Validation is branch- and version-scoped rather than a global usable flag.",
  "type": "object",
  "required": [
    "validation_receipt_id",
    "subject_type",
    "subject_id",
    "branch_id",
    "gate",
    "gate_version",
    "checks",
    "status",
    "validator",
    "reviewer",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "validation_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subject_type": {
      "type": "string"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "branch_id": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "pattern": "^V[0-9]$"
    },
    "gate_version": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED_UNKNOWN",
              "NOT_APPLICABLE",
              "SUPERSEDED"
            ]
          },
          "observed": {},
          "expected": {},
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_locators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "page_or_section": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accessed_utc": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_UNKNOWN",
        "NOT_APPLICABLE",
        "SUPERSEDED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "code_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "validator": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "created_utc": {
      "type": "string"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
